/**
 * @file wifi_credentials.h.example
 * @brief Template for Wi-Fi credentials configuration.
 *
 * Copy this file to "wifi_credentials.h" in the same directory and enter
 * your actual local Wi-Fi SSID and password.
 *
 * "wifi_credentials.h" is ignored by git to avoid committing secret passwords.
 */

#ifndef WIFI_CREDENTIALS_H
#define WIFI_CREDENTIALS_H

// Replace with your local Wi-Fi network SSID
#define WIFI_SSID "YOUR_WIFI_SSID"

// Replace with your local Wi-Fi network password
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#endif // WIFI_CREDENTIALS_H
